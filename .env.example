# Copie este arquivo para .env e preencha com os dados do seu projeto Supabase.
#
#   Painel do Supabase > Project Settings > API
#
# O prefixo VITE_ é obrigatório: só variáveis com esse prefixo chegam ao frontend.
#
# ATENÇÃO: estas duas variáveis ficam visíveis no bundle publicado. Isso é o
# funcionamento oficial do Supabase e é seguro DESDE QUE o Row Level Security
# esteja ativo em todas as tabelas. A chave service_role NUNCA entra aqui.

VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anonima-publica
